{
  "info": {
    "name": "Hotel Offer Orchestrator",
    "description": "Test collection for the TripareAI Hotel Offer Orchestrator assessment (Node.js + Temporal + Redis).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "Get Hotels - Valid City With Overlaps (Delhi)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hotels?city=delhi",
          "host": ["{{baseUrl}}"],
          "path": ["api", "hotels"],
          "query": [{ "key": "city", "value": "delhi" }]
        }
      }
    },
    {
      "name": "Get Hotels - Price Range Filter (Delhi)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hotels?city=delhi&minPrice=4000&maxPrice=6000",
          "host": ["{{baseUrl}}"],
          "path": ["api", "hotels"],
          "query": [
            { "key": "city", "value": "delhi" },
            { "key": "minPrice", "value": "4000" },
            { "key": "maxPrice", "value": "6000" }
          ]
        }
      }
    },
    {
      "name": "Get Hotels - City With No Results (Goa)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hotels?city=goa",
          "host": ["{{baseUrl}}"],
          "path": ["api", "hotels"],
          "query": [{ "key": "city", "value": "goa" }]
        }
      }
    },
    {
      "name": "Get Hotels - Missing City (400)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hotels",
          "host": ["{{baseUrl}}"],
          "path": ["api", "hotels"]
        }
      }
    },
    {
      "name": "Supplier A - Simulate Down (503)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/supplierA/hotels?city=delhi&fail=true",
          "host": ["{{baseUrl}}"],
          "path": ["supplierA", "hotels"],
          "query": [
            { "key": "city", "value": "delhi" },
            { "key": "fail", "value": "true" }
          ]
        }
      }
    },
    {
      "name": "Supplier B - Simulate Down (503)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/supplierB/hotels?city=delhi&fail=true",
          "host": ["{{baseUrl}}"],
          "path": ["supplierB", "hotels"],
          "query": [
            { "key": "city", "value": "delhi" },
            { "key": "fail", "value": "true" }
          ]
        }
      }
    },
    {
      "name": "Supplier A - Raw Mock Data (Delhi)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/supplierA/hotels?city=delhi",
          "host": ["{{baseUrl}}"],
          "path": ["supplierA", "hotels"],
          "query": [{ "key": "city", "value": "delhi" }]
        }
      }
    },
    {
      "name": "Supplier B - Raw Mock Data (Delhi)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/supplierB/hotels?city=delhi",
          "host": ["{{baseUrl}}"],
          "path": ["supplierB", "hotels"],
          "query": [{ "key": "city", "value": "delhi" }]
        }
      }
    },
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    }
  ]
}
